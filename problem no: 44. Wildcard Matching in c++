// SPACE OPTIMIZE...

    bool spaceO(string& s, string& p){
        int s1 = s.length();
        int p1 = p.length();
        vector<int> curr(p1+1, 0);
        vector<int> prev(p1+1, 0);

        prev[0] = true;
        for (int j = 1; j <= p1; j++) {
            if (p[j - 1] == '*')
                prev[j] = prev[j - 1];
        }


        for(int i=1; i<=s1; i++){
            for(int j=1; j<=p1; j++){
                bool ans = false;
                if(s[i-1] == p[j-1] || p[j-1] == '?'){
                    ans = prev[j-1];
                }
                else if(p[j-1] == '*'){
                    bool empty = curr[j-1];
                    bool star = prev[j];

                    ans = empty || star;
                }
                else{
                    ans = false;
                }

                curr[j] = ans;
            }
            prev = curr;
        }
        return prev[p1];

    }
    bool isMatch(string s, string p) {
        // int s1 = s.length();
