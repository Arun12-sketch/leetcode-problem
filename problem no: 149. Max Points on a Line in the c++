class Solution {
public:
    int maxPoints(vector<vector<int>>& points) {
        int n = points.size();
        int result = 1;
        for(int i = 0 ; i < n ; i ++ ){
            int x = points[i][0];
            int y = points[i][1];
            unordered_map<double , int> mp;
            for(int j = 0 ; j < n ; j ++){
                if(i==j) continue;
                double slope = getSlope(x,y,points[j][0] , points[j][1]);
                mp[slope]++;
            }
            for(auto i : mp){
                result = max(result , i.second + 1);
            }
        }
        return result;
    }

    double getSlope(int x1, int y1, int x2, int y2) {
    if (x1 == x2) {
        return (y2 > y1) ? INT_MAX : INT_MIN;
    }
    return 1.0 * (y2 - y1) / (x2 - x1);
}
};
